{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ledgerline/hero-panels",
	"title": "Hero panels (send it in, we close the month, clean books)",
	"category": "widgets",
	"icon": "media-spreadsheet",
	"description": "Three panels that play in order on load: a pile of receipts, the month-end checklist ticking itself off, and a profit and loss that counts up. Net profit is worked out from the figures, so it always adds up.",
	"textdomain": "ledgerline-blocks",
	"attributes": {
		"month": { "type": "string", "default": "May" },
		"receiptCount": { "type": "number", "default": 47 },
		"receiptsImage": { "type": "string", "default": "receipts.webp" },
		"receiptsAlt": { "type": "string", "default": "A pile of paper receipts and envelopes" },
		"chip1": { "type": "string", "default": "Receipts in" },
		"checklistTitle": { "type": "string", "default": "Month-end checklist" },
		"checklist": { "type": "string", "default": "Bank transactions\nCredit card activity\nReconciliations\nBills and payables\nPayroll\nFinancial statements" },
		"doneLabel": { "type": "string", "default": "Done" },
		"statusTodo": { "type": "string", "default": "In progress" },
		"statusDone": { "type": "string", "default": "Complete" },
		"chip2": { "type": "string", "default": "Books closed" },
		"plTitle": { "type": "string", "default": "Profit & Loss" },
		"period": { "type": "string", "default": "May 1 to May 31" },
		"income": { "type": "number", "default": 85230 },
		"cogs": { "type": "number", "default": 33680 },
		"opex": { "type": "number", "default": 28010 },
		"calcImage": { "type": "string", "default": "calculator.webp" },
		"chip3": { "type": "string", "default": "Tax ready" }
	},
	"supports": { "html": false, "reusable": false, "multiple": false, "align": false },
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
